[0.006, "o", "\u001b[2m# cxpm's own --help\u001b[0m\r\n\r\n"]
[1.201, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcxpm --help\u001b[0m\r\n"]
[0.604, "o", "\r\ncxpm: A simple package manager written in C++ for C++\r\nUsage:\r\n    cxpm [option] [arguments]\r\nOptions:\r\n\r\n    -b|--build <directory>: Build project on directory containing package.cpp/package.json\r\n    -i|--install <directory>: Install project on directory containing package.cpp/package.json\r\n    -u|--uninstall <directory>: Uninstall project on directory containing package.cpp/package.json\r\n    -g|--generate <kind> [directory]: Generate a starter manifest; kind is one of\r\n                                        package-cpp, package-json, toolchain-cpp, toolchain-json\r\n                                        (directory defaults to '.'; add --force to overwrite)\r\n\r\n    "]
[0.001, "o", "\r\n"]
[1.102, "o", "\u001b[2m# scaffold a new project — package.json, no build step yet\u001b[0m\r\n\r\n"]
[1.203, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcxpm --generate package-json hello-cxpm\u001b[0m\r\n"]
[0.607, "o", "2026-08-24 20:21:33.641603872: INFO: wrote /tmp/tmp.EbjiZacqBu/hello-cxpm/package.json\r\n"]
[0.000, "o", "\r\n"]
[1.102, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcd hello-cxpm\u001b[0m\r\n"]
[0.602, "o", "\r\n"]
[1.102, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat package.json\u001b[0m\r\n"]
[0.603, "o", "{\r\n  \"targets\": [\r\n    {\r\n      \"dependencies\": [],\r\n      \"description\": \"\",\r\n      \"include_directories\": [\r\n        \"src\"\r\n      ],\r\n      \"install_prefix\": \"\",\r\n      \"language\": \"c++\",\r\n      \"link_directories\": [],\r\n      \"link_libraries\": [\r\n        \"m\"\r\n      ],\r\n      \"name\": \"hello-cxpm\",\r\n      \"options\": [\r\n        \"-fPIE\",\r\n        \"-fstack-protector-all\"\r\n      ],\r\n      \"sources\": [\r\n        \"src/main.cpp\"\r\n      ],\r\n      \"toolchain\": \"g++\",\r\n      \"type\": \"executable\",\r\n      \"url\": \"\",\r\n      \"version\": \"1.0.0\"\r\n    }\r\n  ],\r\n  \"toolchains\": []\r\n}\r\n"]
[0.001, "o", "\r\n"]
[1.106, "o", "\u001b[2m# the target's sources file, written ahead of time\u001b[0m\r\n\r\n"]
[1.202, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat src/main.cpp\u001b[0m\r\n"]
[0.604, "o", "#include <cstdio>\r\n\r\nint main() {\r\n  printf(\"Hello from cxpm!\\n\");\r\n  return 0;\r\n}\r\n"]
[0.001, "o", "\r\n"]
