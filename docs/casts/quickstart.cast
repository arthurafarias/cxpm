[0.006, "o", "\u001b[2m# a library, with a project that tests it and one that uses it\u001b[0m\r\n\r\n"]
[1.202, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcxpm project create greeter --type static-library --tests --example\u001b[0m\r\n"]
[0.608, "o", "created static-library project greeter in /tmp/tmp.f1CL1VpFgf/greeter\r\n"]
[0.000, "o", "\r\n"]
[1.103, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcd greeter\u001b[0m\r\n"]
[0.603, "o", "\r\n"]
[1.103, "o", "\u001b[1;32m$\u001b[0m \u001b[1mfind . -type f | sort\u001b[0m\r\n"]
[0.630, "o", "./example/package.cpp\r\n./example/src/main.cpp\r\n./include/greeter/greeter.hpp\r\n./package.cpp\r\n./src/greeter.cpp\r\n./tests/package.cpp\r\n./tests/src/main.cpp\r\n"]
[0.000, "o", "\r\n"]
[1.103, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcat package.cpp\u001b[0m\r\n"]
[0.605, "o", "#include <cxpm/Project.hpp>\r\n#include <cxpm/Target.hpp>\r\n\r\nusing namespace cxpm;\r\n\r\nauto target = Target()\r\n                  .name_set(\"greeter\")\r\n                  .version_set(\"0.1.0\")\r\n                  .type_set(\"static-library\")\r\n                  .sources_append({\"src/*.cpp\"})\r\n                  .include_directories_append({\"include\"})\r\n                  .create();\r\n\r\nauto project = Project().target_set(target).members_append(\"example\").tests_append(\"tests\").create();\r\n"]
[0.000, "o", "\r\n"]
[1.103, "o", "\u001b[2m# build: the library is installed into the workspace sysroot for the example\u001b[0m\r\n\r\n"]
[1.204, "o", "\u001b[1;32m$\u001b[0m \u001b[1mcxpm build\u001b[0m\r\n"]
